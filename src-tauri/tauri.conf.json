{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisper 字幕生成器",
  "version": "1.0.0",
  "identifier": "com.liuhongwei.whispersubtitletool",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Whisper 字幕生成器",
        "width": 1200,
        "height": 920,
        "minWidth": 760,
        "minHeight": 620,
        "backgroundColor": "#f1f5f9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [],
    "targets": "nsis",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}
